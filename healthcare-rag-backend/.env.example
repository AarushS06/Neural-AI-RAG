# Storage & Upload limits
RAG_DATA_DIR=./data
MAX_UPLOAD_MB=25
MAX_FILE_MB=25
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=8
EMBEDDING_MODEL=local-hash-384

# LLM Provider Configuration
# Set LLM_PROVIDER=openai to enable ChatGPT responses, or "local" for deterministic extractive fallback.
# Keep the real key out of source control; inject OPENAI_API_KEY in the shell/container environment
# or place it only in a local, uncommitted .env file.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30.0
LLM_BASE_URL=

# Web Search API Keys (Optional)
# If GOOGLE keys are not provided, system automatically uses free Europe PMC, Semantic Scholar & PubMed APIs
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
REQUEST_TIMEOUT=15.0

# General Infrastructure
QDRANT_URL=
QDRANT_API_KEY=
RERANKER_ENABLED=false
CORS_ORIGINS=*
DEFAULT_TEMPLATE=research_papers
